if [ -n "$XDG_SESSION_TYPE" ] && [ "$XDG_SESSION_TYPE" != wayland ]; then
    if [ -x "$(command -v xrdb)" ]; then
        if [ -f ~/.Xresources ]; then
            xrdb -merge ~/.Xresources
        fi
        if [ -f ~/.Xresources.d/custom ]; then
            xrdb -merge ~/.Xresources.d/custom
        fi
    fi
fi
